     <script>
+/* Unit Pacer: namespace all localStorage keys. This app may share a browser origin with
+   another planner (e.g. two GitHub Pages repos under the same account), and both use
+   keys like "plannerProfiles". The prefix keeps their data completely separate. */
+const localStorage = (() => {
+  const real = window.localStorage;
+  const P = "unitpacer:";
+  const ownKeys = () => {
+    const out = [];
+    for (let i = 0; i < real.length; i++) {
+      const k = real.key(i);
+      if (k && k.startsWith(P)) out.push(k.slice(P.length));
+    }
+    return out;
+  };
+  const api = {
+    getItem: k => real.getItem(P + k),
+    setItem: (k, v) => real.setItem(P + k, String(v)),
+    removeItem: k => real.removeItem(P + k),
+    key: i => ownKeys()[i] ?? null,
+    clear: () => ownKeys().forEach(k => real.removeItem(P + k))
+  };
+  return new Proxy({}, {
+    get(_, prop) {
+      if (prop === "length") return ownKeys().length;
+      if (prop in api) return api[prop];
+      if (typeof prop !== "string") return undefined;
+      const v = real.getItem(P + prop);
+      return v === null ? undefined : v;
+    },
+    ownKeys: () => ownKeys(),
+    getOwnPropertyDescriptor(_, k) {
+      const v = real.getItem(P + String(k));
+      return v === null ? undefined : { value: v, enumerable: true, configurable: true, writable: true };
+    }
+  });
+})();
 let savedPacks = JSON.parse(localStorage.getItem("plannerSavedPacks") || "[]");
